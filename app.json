{
  "expo": {
    "name": "Donat Dankau POS",
    "slug": "donatdankau-fe",
    "version": "1.0.0",
    "scheme": "donatdankau-pos",
    "orientation": "portrait",
    "icon": "./assets/donat-dankau-logo.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9F2",
    "plugins": [
      "./plugins/with-short-android-cmake-path",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Donat Dankau POS memilih foto produk dari galeri."
        }
      ],
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.donatdankau.pos"
    },
    "android": {
      "package": "id.donatdankau.pos",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F2",
        "foregroundImage": "./assets/donat-dankau-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/donat-dankau-logo.png"
    }
  }
}
